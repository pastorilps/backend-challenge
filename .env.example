AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000

POSTGRES_USER=root
POSTGRES_PASSWORD=rootpassword
POSTGRES_DB=monkeyg
POSTGRES_PORT=5432
APP_PORT=3000
MINISTACK_PORT=4566

SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_NAME=wager-events.fifo
SQS_CONSUMER_NAME=wager-transaction-consumer
SQS_MAX_ATTEMPTS=5
SQS_RETRY_BASE_DELAY_MS=1000
SQS_RETRY_MAX_DELAY_MS=300000
SQS_VISIBILITY_TIMEOUT_SECONDS=60
SQS_WAIT_TIME_SECONDS=20
OUTBOX_BATCH_SIZE=10
OUTBOX_POLL_INTERVAL_MS=1000

# These hostnames are for services running inside Docker Compose.
DATABASE_URL=postgresql://root:rootpassword@postgres:5432/monkeyg
SQS_ENDPOINT_URL=http://ministack:4566
SQS_QUEUE_URL=http://ministack:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://ministack:4566/000000000000/wager-transactions-dlq.fifo
SQS_EVENTS_QUEUE_URL=http://ministack:4566/000000000000/wager-events.fifo
SQS_HEALTHCHECK_URL=http://ministack:4566/_ministack/health

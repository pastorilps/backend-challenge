AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000

SQS_QUEUE_NAME=wager-transactions.fifo
SQS_DLQ_NAME=wager-transactions-dlq.fifo
SQS_MAX_ATTEMPTS=5

# For the Nest application running on the host:
SQS_ENDPOINT_URL=http://localhost:4566
SQS_QUEUE_URL=http://localhost:4566/000000000000/wager-transactions.fifo
SQS_DLQ_URL=http://localhost:4566/000000000000/wager-transactions-dlq.fifo
SQS_HEALTHCHECK_URL=http://localhost:4566/_ministack/health

# PostgreSQL published by docker-compose:
DATABASE_URL=postgresql://root:rootpassword@localhost:5432/my_database
